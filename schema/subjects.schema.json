{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learn.sagunpradhan.com.np/schema/subjects.schema.json",
  "title": "Subjects",
  "type": "object",
  "required": ["subjects"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "description", "icon", "theme"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "description": "Also the folder name under content/lessons/." },
          "name": { "type": "string" },
          "nameLocal": { "type": "string" },
          "description": { "type": "string" },
          "icon": { "type": "string", "description": "An emoji." },
          "theme": { "enum": ["emerald", "indigo", "rose", "amber", "sky", "violet"] }
        }
      }
    }
  }
}
